rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Los perfiles de usuario pueden ser consultados (para verificar nombre de usuario y ver perfiles)
    // Pero solo el propio usuario autenticado puede escribir o modificar su propio documento.
    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;

      match /favorites/{placeId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Historial de Spotty (chatbot): privado, solo el dueño lee, escribe y borra sus chats.
      match /chats/{chatId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        match /messages/{messageId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }

    // Solicitudes temporales de cambio de contraseña para validación por enlace de correo
    match /password_resets/{email} {
      allow read, write: if true;
    }

    // Lugares del Home (se cargan con data_import/excel_to_json.ps1): cualquiera los lee; nadie
    // los modifica desde la app.
    match /places/{placeId} {
      allow read: if true;
      allow write: if false;
    }

    // Comentarios de los lugares del Home: cualquiera los lee; solo usuarios con sesión publican
    // a su nombre (uid propio) y cada autor puede editar o borrar los suyos.
    match /places/{placeId}/comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500;
      allow update, delete: if request.auth != null && (resource.data.uid == request.auth.uid || resource.data.uid == "");
    }
  }
}
